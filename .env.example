DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
# Configuración de Azure (Capa Bronce, Plata y Oro)
AZURE_DB_USER=
AZURE_DB_PASSWORD=
AZURE_DB_HOST=
AZURE_DB_NAME=
AZURE_DB_URL=
AZURE_STORAGE_CONNECTION_STRING=

# OpenRouteService (para Bloque 4 — Accesibilidad y routing)
# Registro gratuito en: https://openrouteservice.org/dev/#/signup
# Plan free: 500 peticiones/día, 3.500 pares origen-destino por petición (suficiente para 2.396 hex × 6 destinos)
ORS_API_KEY=

# YouTube API
YOUTUBE_API_KEY=

# Tripadvisor API
TRIPADVISOR_KEY=

# Google Earth Engine (para Sentinel-2 NDVI/NDBI y VIIRS luces nocturnas)
# Crear proyecto en: https://earthengine.google.com/
# Autenticar con: earthengine authenticate
GEE_PROJECT_ID=

# NASA Earthdata (para descarga VIIRS directa de NASA LAADS DAAC — alternativa a GEE)
# Registrarse en: https://urs.earthdata.nasa.gov/
# Generar token Bearer en: https://urs.earthdata.nasa.gov/users/<tu_usuario>/user_tokens
EARTHDATA_TOKEN=

# Mapbox (basemap satelital del dashboard)
# Crear cuenta gratis en: https://account.mapbox.com/auth/signup/
# Token por defecto (public, pk.*) en: https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=

# Groq (LLM para el informe narrativo y para el botón "Traducir" del dashboard en app/translation.py)
# Registro gratuito en: https://console.groq.com/keys
GROQ_API_KEY=
