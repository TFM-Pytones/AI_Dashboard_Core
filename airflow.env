# Variables de entorno para el stack de Airflow (docker-compose.yml).
# Este fichero se referencia en docker-compose.yml con env_file:.

# IMPORTANTE: Las credenciales reales se cargan desde el .env del proyecto.
# Este fichero solo contiene configuración de Airflow.

# Airflow Core
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=8
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120

# Base de datos metadata de Airflow
# Se conecta al servicio postgres-airflow del docker-compose
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres-airflow:5432/airflow

# Webserver
AIRFLOW__WEBSERVER__SECRET_KEY=tfm-tenerife-secret-key-cambiar-en-produccion
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

# Scheduler
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=60
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=60

# Logging
AIRFLOW__LOGGING__LOG_LEVEL=INFO

# Variables del proyecto (se pasan a los tasks)
# REPO_ROOT: path donde se monta el repositorio dentro del contenedor
REPO_ROOT=/opt/airflow/repo

# RUN_HEAVY_ML: controla si se ejecutan tasks de GPU (sentiment, aspects, topics)
# Cambiar a 'true' cuando haya GPU disponible o se quiera ejecutar en CPU con paciencia
RUN_HEAVY_ML=false